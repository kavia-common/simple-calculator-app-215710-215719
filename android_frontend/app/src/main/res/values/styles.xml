<resources>
    <style name="CalcKeyBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textSize">18sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalcKey" parent="CalcKeyBase"/>

    <style name="CalcKeyWide" parent="CalcKeyBase">
        <item name="android:layout_columnSpan">2</item>
    </style>

    <style name="OpKey" parent="CalcKeyBase">
        <item name="android:layout_width">match_parent</item>
        <item name="android:textColor">@color/surfaceColor</item>
        <item name="android:background">@drawable/bg_key_primary</item>
    </style>

    <style name="OpKeyPrimary" parent="OpKey">
        <item name="android:background">@drawable/bg_key_accent</item>
    </style>

    <style name="OpKeySecondary" parent="OpKey">
        <item name="android:background">@drawable/bg_key_secondary</item>
        <item name="android:textColor">@color/surfaceColor</item>
    </style>
</resources>
